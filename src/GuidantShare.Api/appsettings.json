{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Email": { "Mode": "Log", "PublicBaseUrl": "http://localhost:5080" },
  "Upload": { "MaxBytes": 524288000 },
  "FileSync": { "BaseUrl": "http://localhost:5000", "CacheSeconds": 45 }
}
